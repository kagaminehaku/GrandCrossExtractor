<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputPath>..\bin\$(Configuration)\GrandCrossExtractor\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <Product>GrandCross Extractor</Product>
    <AssemblyTitle>GrandCross Extractor</AssemblyTitle>
    <Description>Browse, preview and extract resources from Grand Cross (ShiinaRio engine) visual novels.</Description>
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>kagaminehaku</Authors>
    <Copyright>Copyright (c) 2026 kagaminehaku. Portions Copyright (c) 2014-2020 morkt (GARbro).</Copyright>
    <RepositoryUrl>https://github.com/kagaminehaku/GrandCrossExtractor</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\icon.ico" />
  </ItemGroup>

  <!-- Scheme data: Formats.Json plus the shared ShiinaImage/Common.bin and per-game *.tail files -->
  <ItemGroup>
    <None Update="Formats.Json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="ShiinaImage\*.bin" CopyToOutputDirectory="PreserveNewest" />
    <None Update="ShiinaImage\*.tail" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <!-- Play Story: mixes BGM, voice and sound effects -->
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
  </ItemGroup>

</Project>
