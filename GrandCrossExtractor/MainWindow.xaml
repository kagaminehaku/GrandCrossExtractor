<Window x:Class="GrandCrossExtractor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GrandCrossExtractor"
        xmlns:ui="clr-namespace:GrandCrossExtractor.UI"
        mc:Ignorable="d"
        Title="GRAND†CROSS Resource Extractor - ShiinaRio Engine (.NET 10)"
        Height="720" Width="1160" MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#141418" Foreground="#E0E0E6"
        FontFamily="Segoe UI, Segoe UI Variable, Arial"
        Icon="Resources/icon.ico">

    <Window.Resources>
        <ui:FileSizeConverter x:Key="FileSizeConverter" />
        <ui:RatioConverter x:Key="RatioConverter" />

        <!-- ScrollViewer Theme -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="Foreground" Value="#555566"/>
        </Style>

        <!-- Dark ComboBox Style -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
            <Border x:Name="templateRoot" Background="#262632" BorderBrush="#3E3E4E" BorderThickness="1" CornerRadius="4">
                <Border x:Name="splitBorder" Width="24" HorizontalAlignment="Right" BorderThickness="1,0,0,0" BorderBrush="#3E3E4E">
                    <Path x:Name="arrow" Data="M 0,0 L 4,4 L 8,0 Z" Fill="#A0A0B4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/>
                </Border>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter Property="Background" TargetName="templateRoot" Value="#38384A"/>
                    <Setter Property="BorderBrush" TargetName="templateRoot" Value="#7C4DFF"/>
                    <Setter Property="BorderBrush" TargetName="splitBorder" Value="#7C4DFF"/>
                    <Setter Property="Fill" TargetName="arrow" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="true">
                    <Setter Property="Background" TargetName="templateRoot" Value="#262632"/>
                    <Setter Property="BorderBrush" TargetName="templateRoot" Value="#7C4DFF"/>
                    <Setter Property="BorderBrush" TargetName="splitBorder" Value="#7C4DFF"/>
                    <Setter Property="Fill" TargetName="arrow" Value="#FFFFFF"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="#262632"/>
            <Setter Property="Foreground" Value="#EEEEF2"/>
            <Setter Property="BorderBrush" Value="#3E3E4E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid x:Name="templateRoot">
                            <ToggleButton x:Name="toggleButton" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Template="{StaticResource ComboBoxToggleButton}"/>
                            <ContentPresenter x:Name="contentPresenter" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Content="{TemplateBinding SelectionBoxItem}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" IsHitTestVisible="false" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="true" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}">
                                <Border x:Name="dropDownBorder" Background="#262632" BorderBrush="#3E3E4E" BorderThickness="1" CornerRadius="4" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{Binding ActualWidth, ElementName=templateRoot}">
                                    <ScrollViewer x:Name="DropDownScrollViewer">
                                        <Grid x:Name="grid" RenderOptions.ClearTypeHint="Enabled">
                                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#262632"/>
            <Setter Property="Foreground" Value="#EEEEF2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3B2667"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5314D6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Style -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="#2A2A34"/>
            <Setter Property="Foreground" Value="#EEEEF2"/>
            <Setter Property="BorderBrush" Value="#3E3E4E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#38384A"/>
                                <Setter Property="BorderBrush" Value="#7C4DFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#7C4DFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="#651FFF"/>
            <Setter Property="BorderBrush" Value="#7C4DFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#7C4DFF"/>
                                <Setter Property="BorderBrush" Value="#B388FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#5314D6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListView Item Style -->
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EEEEF2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <GridViewRowPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252532"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3B2667"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GridViewColumnHeader Style -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#1A1A22"/>
            <Setter Property="Foreground" Value="#A0A0B4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#2A2A38"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Top Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Sub-toolbar & Filters -->
            <RowDefinition Height="*"/>
            <!-- Main Content Area -->
            <RowDefinition Height="Auto"/>
            <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- TOP HEADER & TITLE TOOLBAR -->
        <Border Grid.Row="0" Background="#1A1A22" BorderBrush="#2A2A38" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                    <Border Width="30" Height="30" Background="#651FFF" CornerRadius="6" Margin="0,0,10,0">
                        <TextBlock Text="†" Foreground="White" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="GRAND†CROSS Extractor" FontWeight="Bold" FontSize="15" Foreground="#F0F0FA"/>
                        <TextBlock Text="ShiinaRio Engine Archive &amp; Media Browser" FontSize="11" Foreground="#8A8A9E"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center Main Action Buttons -->
                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="BtnOpen" Content="📁 Open Archive..." Style="{StaticResource AccentBtn}" Margin="4,0" Click="BtnOpen_Click" ToolTip="Open .WAR, .WARC, or .S25 Archive"/>
                    <Button x:Name="BtnExtractSelected" Content="💾 Extract Selected" Style="{StaticResource ModernBtn}" Margin="4,0" Click="BtnExtractSelected_Click" IsEnabled="False"/>
                    <Button x:Name="BtnExtractAll" Content="📦 Extract All" Style="{StaticResource ModernBtn}" Margin="4,0" Click="BtnExtractAll_Click" IsEnabled="False"/>
                    <Button x:Name="BtnPlayStory" Content="▶ Play Story" Style="{StaticResource ModernBtn}" Margin="4,0" Click="BtnPlayStory_Click" IsEnabled="False"
                            ToolTip="Read the game's story with its pictures, voices and music, straight from the archives of this game folder. Available for: Oreimo Plus."/>
                    <CheckBox x:Name="ChkConvert" Content="Convert on extract" IsChecked="True" Foreground="#C0C0D0" VerticalAlignment="Center" Margin="10,0,0,0"
                              ToolTip="S25/MI4 → PNG (one file per frame), OGV → OGG, PAD → WAV. Uncheck to save the raw decrypted files."/>
                    <CheckBox x:Name="ChkCompose" Content="Compose layers" IsChecked="False" Foreground="#C0C0D0" VerticalAlignment="Center" Margin="10,0,0,0"
                              IsEnabled="{Binding IsChecked, ElementName=ChkConvert}"
                              ToolTip="Layered S25 images (event CGs, character sprites) are saved as the complete pictures the game shows, with the eyes, mouth and effects the scenario scripts choose, instead of separate frames. Needs the game's script archive (*_T.WAR) in the same folder."/>
                </StackPanel>

                <!-- Game Scheme Selector -->
                <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Scheme:" Foreground="#A0A0B4" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                    <ComboBox x:Name="CmbScheme" Width="200" Height="28" Background="#262632" Foreground="#EEEEF2"
                              BorderBrush="#3E3E4E" SelectionChanged="CmbScheme_SelectionChanged"
                              ToolTip="Select encryption scheme for GRAND†CROSS / ShiinaRio games" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- SECONDARY FILTER & SEARCH BAR -->
        <Border Grid.Row="1" Background="#16161E" BorderBrush="#252530" BorderThickness="0,0,0,1" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Quick Filter Buttons -->
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <RadioButton x:Name="FilterAll" Content="All Files" IsChecked="True" Foreground="#C0C0D0" Margin="0,0,12,0" VerticalAlignment="Center" Checked="FilterType_Changed"/>
                    <RadioButton x:Name="FilterImages" Content="🖼 Images (S25/MI4/BMP)" Foreground="#C0C0D0" Margin="0,0,12,0" VerticalAlignment="Center" Checked="FilterType_Changed"/>
                    <RadioButton x:Name="FilterAudio" Content="🎵 Audio (OGV/PAD/WAV)" Foreground="#C0C0D0" Margin="0,0,12,0" VerticalAlignment="Center" Checked="FilterType_Changed"/>
                    <RadioButton x:Name="FilterScripts" Content="📜 Scripts / Text" Foreground="#C0C0D0" Margin="0,0,12,0" VerticalAlignment="Center" Checked="FilterType_Changed"/>
                </StackPanel>

                <!-- Search Box -->
                <StackPanel Orientation="Horizontal" Grid.Column="3">
                    <TextBlock Text="🔍 Filter:" Foreground="#8A8A9E" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtSearch" Width="180" Height="24" Background="#20202A" Foreground="#FFFFFF"
                             BorderBrush="#383848" Padding="4,2" TextChanged="TxtSearch_TextChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN SPLIT CONTENT: FILE LIST & PREVIEW -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="320"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: FILE LIST -->
            <Border Grid.Column="0" Background="#181820" Margin="0">
                <ListView x:Name="FileListView" Background="Transparent" BorderThickness="0"
                          SelectionMode="Extended" SelectionChanged="FileListView_SelectionChanged"
                          MouseDoubleClick="FileListView_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="260" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Type" Width="70" DisplayMemberBinding="{Binding Type}"/>
                            <GridViewColumn Header="Size" Width="85" DisplayMemberBinding="{Binding UnpackedSize, Converter={StaticResource FileSizeConverter}}"/>
                            <GridViewColumn Header="Packed" Width="85" DisplayMemberBinding="{Binding Size, Converter={StaticResource FileSizeConverter}}"/>
                            <GridViewColumn Header="Ratio" Width="60">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource RatioConverter}">
                                                    <Binding Path="Size"/>
                                                    <Binding Path="UnpackedSize"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" Width="5" Background="#252530" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- RIGHT: PREVIEW PANEL -->
            <Border Grid.Column="2" Background="#1A1A24" BorderBrush="#252530" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Preview Header Info -->
                        <RowDefinition Height="*"/>
                        <!-- Preview Content Display -->
                        <RowDefinition Height="Auto"/>
                        <!-- Preview Controls (Zoom, Audio controls, Frame picker) -->
                    </Grid.RowDefinitions>

                    <!-- Preview Header -->
                    <Border Grid.Row="0" Background="#20202C" BorderBrush="#2C2C3C" BorderThickness="0,0,0,1" Padding="12,8">
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="TxtPreviewName" Text="No file selected" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtPreviewDetails" Text="Select an entry from the list to preview" FontSize="11" Foreground="#9999AA" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Preview Content -->
                    <Grid Grid.Row="1">
                        <!-- 1. EMPTY / WELCOME STATE -->
                        <StackPanel x:Name="PanelWelcome" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible">
                            <TextBlock Text="📂" FontSize="48" HorizontalAlignment="Center" Opacity="0.5"/>
                            <TextBlock Text="Open a GRAND†CROSS .war archive or .s25 image"
                                       Foreground="#808096" FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                            <TextBlock Text="Supports Azu Plus, ERO-ON, Kuroneko Plus, Maki Fes!, Nyaru Plus, Re: Rem Plus, Yuru Plus"
                                       Foreground="#606076" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- 2. IMAGE PREVIEW -->
                        <Grid x:Name="PanelImagePreview" Visibility="Collapsed">
                            <!-- Checkerboard transparency background -->
                            <Border Background="#121216">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <Image x:Name="ImgPreview" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <!-- 3. AUDIO PREVIEW -->
                        <Grid x:Name="PanelAudioPreview" Visibility="Collapsed" Background="#14141C">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="70" Height="70" Background="#651FFF" CornerRadius="35" HorizontalAlignment="Center" Margin="0,0,0,16">
                                    <TextBlock Text="🎵" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TxtAudioTrackName" Text="Track Title" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Foreground="#FFFFFF"/>
                                <TextBlock x:Name="TxtAudioFormat" Text="OGV / OGG / PAD / WAV" FontSize="12" Foreground="#8888AA" HorizontalAlignment="Center" Margin="0,4,0,16"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="BtnAudioPlay" Content="▶ Play" Style="{StaticResource AccentBtn}" Width="90" Click="BtnAudioPlay_Click" Margin="0,0,8,0"/>
                                    <Button x:Name="BtnAudioStop" Content="⏹ Stop" Style="{StaticResource ModernBtn}" Width="90" Click="BtnAudioStop_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 4. TEXT / SCRIPT PREVIEW -->
                        <Grid x:Name="PanelTextPreview" Visibility="Collapsed">
                            <TextBox x:Name="TxtPreviewContent" Background="#121216" Foreground="#D0D0E0"
                                     FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12"
                                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     BorderThickness="0" Padding="10"/>
                        </Grid>

                        <!-- 5. HEX DUMP PREVIEW -->
                        <Grid x:Name="PanelHexPreview" Visibility="Collapsed">
                            <TextBox x:Name="TxtHexContent" Background="#101014" Foreground="#70D090"
                                     FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11"
                                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     BorderThickness="0" Padding="10"/>
                        </Grid>
                    </Grid>

                    <!-- Preview Controls (Bottom Bar for Preview) -->
                    <Border Grid.Row="2" Background="#181822" BorderBrush="#242430" BorderThickness="0,1,0,0" Padding="8,4">
                        <Grid>
                            <!-- Frame Selector for Multi-Frame S25 -->
                            <StackPanel x:Name="PanelFrameSelector" Orientation="Horizontal" HorizontalAlignment="Left" Visibility="Collapsed">
                                <TextBlock Text="Frame:" Foreground="#A0A0B0" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button x:Name="BtnPrevFrame" Content="◀" Style="{StaticResource ModernBtn}" Padding="6,2" Click="BtnPrevFrame_Click"/>
                                <TextBlock x:Name="TxtFrameIndicator" Text="1 / 1" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="6,0"/>
                                <Button x:Name="BtnNextFrame" Content="▶" Style="{StaticResource ModernBtn}" Padding="6,2" Click="BtnNextFrame_Click"/>
                            </StackPanel>

                            <!-- Single File Extract Button -->
                            <Button x:Name="BtnExtractCurrent" Content="Export This File..." Style="{StaticResource ModernBtn}"
                                    HorizontalAlignment="Right" Padding="10,3" Click="BtnExtractCurrent_Click" IsEnabled="False"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="3" Background="#101014" BorderBrush="#202028" BorderThickness="0,1,0,0" Padding="12,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Archive Path / Loaded Info -->
                <TextBlock x:Name="TxtStatusArchive" Text="Ready. Click 'Open Archive...' to begin." Foreground="#8A8A9E" FontSize="11" VerticalAlignment="Center" Grid.Column="0"/>

                <!-- Progress Bar during extraction -->
                <ProgressBar x:Name="ProgExtraction" Grid.Column="1" Height="8" Margin="20,0" Minimum="0" Maximum="100"
                             Background="#202028" Foreground="#651FFF" Visibility="Collapsed" VerticalAlignment="Center"/>

                <!-- Active Scheme & Counts -->
                <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="TxtStatusScheme" Text="Scheme: (None)" Foreground="#A0A0C0" FontSize="11" Margin="0,0,16,0"/>
                    <TextBlock x:Name="TxtStatusCount" Text="0 items" Foreground="#8A8A9E" FontSize="11"/>
                </StackPanel>

                <!-- Unpacked Total Size -->
                <TextBlock x:Name="TxtStatusTotalSize" Text="" Foreground="#8A8A9E" FontSize="11" VerticalAlignment="Center" Grid.Column="3"/>
            </Grid>
        </Border>
    </Grid>
</Window>
